# Full public URL of the service, used to construct shareable page URLs.
# In production, set this to your domain or local DNS name.
# Example: http://pushpage.homelab.local
APP_SERVER_URL=http://localhost:8080

# Host port that nginx binds to.
# Change this if port 8080 is already in use on your host.
NGINX_PORT=8080

# ── Optional features (both off by default) ─────────────────────────────
# Subscription plans: daily publish quota + plan-based page retention
# (tier1/tier2/tier3, set per user by an admin). Admins are always exempt.
PLANS_ENABLED=false

# Sign-up email verification: users must confirm their address before they can
# log in. Requires working SMTP settings below.
EMAIL_VERIFICATION_ENABLED=false

# SMTP credentials used to send the confirmation email when
# EMAIL_VERIFICATION_ENABLED=true. Any SMTP-capable provider works (Mailtrap, Resend, SES,
# Sendgrid, Postmark, ...) — only these values change per provider, no code
# changes needed.
EMAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=no-reply@pushpage.link

# How long a verification link stays valid before the user must request a new one.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# Abuse protection for sendVerificationEmail — see docs/email-verification.md
EMAIL_VERIFICATION_RATE_LIMIT_PER_MINUTE=1
EMAIL_RESEND_IP_RATE_LIMIT_RPM=5
